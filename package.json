{
  "name": "global-government-contracts-aggregator",
  "version": "1.0.0",
  "description": "US federal award monitoring and global tender intelligence from official USAspending, SAM.gov, TED, and UK Contracts Finder sources.",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/*.test.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "apify": "^3.2.5"
  },
  "devDependencies": {
    "@apify/tsconfig": "^0.1.0",
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "apify-client": "2.25.0",
    "basic-ftp": "6.2.2",
    "brace-expansion": "5.0.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
